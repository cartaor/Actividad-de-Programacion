def ReplaceWords(phrase, word, wordReplace, numReplace):
    result = ''
    rebuildword = ''
    num = 0
    for i in range(len(phrase)):
        if phrase[i] != ' ':
            rebuildword+=phrase[i]
        elif word == rebuildword and num < numReplace:
            result+=f'{wordReplace} '
            rebuildword = ''
            num+=1
        else:
            result+=f'{rebuildword} '
            rebuildword = ''
    if word == rebuildword and num < numReplace:
        result+=wordReplace
    else:
        result+=rebuildword
    return result

