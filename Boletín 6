def camelCase(frase):
    solucion = ''
    for i in range(len(frase)):
        if frase[i] != ' ':
            if i > 0 and frase[i-1] == ' ':
                solucion += frase[i].upper()
            else:
                solucion += frase[i].lower()
    return solucion

