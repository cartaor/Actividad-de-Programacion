def ReplaceWords(phrase, word, wordReplace):
    result = ''
    rebuildword = ''
    for i in range(len(phrase)):
        if phrase[i] != ' ':
            rebuildword+=phrase[i]
        elif word == rebuildword:
            result+=f'{wordReplace} '
            rebuildword = ''
        else:
            result+=f'{rebuildword} '
            rebuildword = ''
    if word == rebuildword:
        result+=wordReplace
    else:
        result+=rebuildword
    return result

assert(ReplaceWords('Esta frase es de prueba', 'frase', 'palabra') == 'Esta palabra es de prueba')
assert(ReplaceWords('El huevo azul', 'azul', 'verde') == 'El huevo verde')
assert(ReplaceWords('La cocina sucia', 'sucia', 'limpia') == 'La cocina limpia')
assert(ReplaceWords('El perro que duerme', 'duerme', 'salta') != 'El perro que ladra')
assert(ReplaceWords('Te gusta comer chocolate', 'chocolate', 'uvas') != 'Te gusta comer helado')
