def palindrome(string):
    newString = ''
    ogString = ''
    result = False
    for i in range(len(string)-1, -1, -1):
        if string[i] != ' ':
            newString+=string[i]
    for j in range(len(string)):
        if string[j] != ' ':
            ogString+=string[j]
    if newString.upper() == ogString.upper():
        result = True
    return result

