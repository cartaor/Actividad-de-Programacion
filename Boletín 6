def RotarNPosiciones(cadena, rotado):
    resultado = ''
    for i in range(rotado-rotado+1):
        resultado+=cadena[-rotado+i:]
    for j in range(len(cadena)-rotado):
        resultado+=cadena[j]
    return print(resultado)

